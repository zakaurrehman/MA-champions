node_modules/
.next/
# Anchored with a leading slash so these only match a build output directory at
# the repo root. Unanchored, "build/" matches at ANY depth — which silently
# excluded app/build/page.tsx, our Belt Builder route, and made /build a 404 in
# production while every local build worked fine.
/out/
/build/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env*
!.env.example
.vercel
*.tsbuildinfo
next-env.d.ts
public/sitemap*.xml
public/robots.txt

# Original camera folders. Kept locally as the source of truth for product
# photos; the web-ready copies live in public/products/. Excluded because they
# are large duplicates and their names contain spaces and \$ characters.
source-photos/
