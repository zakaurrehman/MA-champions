# Copy to .env.local and fill it in there.
#
# THIS FILE IS COMMITTED TO GIT. Never put a real value in it — GitHub's secret
# scanning will block the push, and anything that slips past is public. Real
# values belong in .env.local (git-ignored) and in the Vercel dashboard.
#
# Every service below is optional. Each one missing degrades to a working site
# rather than an error; the comments say what stops working.

# Neon Postgres - from the Vercel Storage tab, ".env.local" quickstart snippet.
# Reviews fall back to the JSON seed when this is absent, so the site still
# builds and renders without it.
#
# After setting this, create the tables once:
#   npm run migrate
#
# Not strictly required: every table and column is also created on demand by
# the API route that needs it. Running it just does the whole schema at once.
DATABASE_URL=

# Production URL. Feeds canonical URLs, the sitemap, robots.txt and structured
# data. Must match the domain actually served.
SITE_URL=https://www.mawrestlingbelts.com

# Customer accounts.
#
# AUTH_SECRET alone enables email-and-password sign-in, and signs both the
# session cookie and the order-confirmation access tokens. GOOGLE_* are extra:
# without them the "Continue with Google" button is hidden and everything else
# still works. Without any of them the account page says sign-in is off — and
# checkout never requires an account, so nothing else is affected.
#
# Get the client id and secret from console.cloud.google.com → APIs & Services
# → Credentials → OAuth client ID (type: Web application).
# Authorised redirect URI must be exactly:
#   https://www.mawrestlingbelts.com/api/auth/callback/google
#
# AUTH_SECRET signs the session cookie. MINIMUM 32 CHARACTERS — a shorter one
# is treated as unset, because a guessable signing key means anyone can forge a
# session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Vercel Blob — file storage for every upload on the site: product photos from
# the admin panel, customer review photos, payment screenshots and custom-order
# artwork. Set automatically when you create a Blob store in the Vercel
# dashboard (Storage → Create → Blob); copy it here for local development.
#
# Without it those uploads are refused with a clear message. Nothing else
# breaks: reviews still post without photos, and orders still record without a
# screenshot.
BLOB_READ_WRITE_TOKEN=

# PayPal. Card checkout stays hidden until BOTH of these exist, so the site
# never shows a pay button that cannot take money.
#
# IMPORTANT: PayPal does not onboard businesses registered in Pakistan. These
# must come from a PayPal Business account in a supported country — in practice
# that means a US or UK company. Get them from developer.paypal.com → Apps.
#
# Leave PAYPAL_ENV unset (or "sandbox") while testing. Only "live" takes real
# money, so a test key can never accidentally charge a customer.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Transactional email, for password reset links. Without these, resets are NOT
# emailed — the link is still created and still valid, and appears under
# /admin/settings for you to send by hand.
#
# Free tier at resend.com is 3,000 emails a month. EMAIL_FROM must be an
# address on a domain you have verified with them, e.g.
#   M.A Champions Belts <noreply@mawrestlingbelts.com>
RESEND_API_KEY=
EMAIL_FROM=

# Sign-in for /admin. Username defaults to "admin" if left blank.
#
# These two are the BOOTSTRAP credential. Once you have set a password from
# /admin/settings it is stored (hashed) in the database, and you should DELETE
# both of these from the host — otherwise the old password keeps working.
#
# MINIMUM 12 CHARACTERS on the password — anything shorter is treated as unset
# and the panel stays closed. Leave the password blank to disable admin
# entirely. This one secret protects the whole shop: prices, orders, customer
# emails. Use a long passphrase you do not use anywhere else.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The original name for the same secret. Still honoured so existing deployments
# keep working; ADMIN_PASSWORD wins when both are set.
ADMIN_TOKEN=
