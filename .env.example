# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — from the Vercel Storage tab, ".env.local" quickstart snippet.
# Reviews fall back to the JSON seed when this is absent, so the site still
# builds and renders without it.
DATABASE_URL=

# Production URL. Feeds canonical URLs, the sitemap and robots.txt, and must
# match `site.url` in lib/site.ts.
SITE_URL=https://machampionsbelts.com
