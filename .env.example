# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres - from the Vercel Storage tab, ".env.local" quickstart snippet.
# Reviews fall back to the JSON seed when this is absent, so the site still
# builds and renders without it.
#
# After setting this, create the table once:
#   node --env-file=.env.local scripts/migrate.mjs
DATABASE_URL=

# Production URL. Feeds canonical URLs, the sitemap, robots.txt and structured
# data. Must match the domain actually served.
SITE_URL=https://www.mawrestlingbelts.com

# Customer sign-in with Google. All three are required — without them the
# account page explains that sign-in is off and everything else still works,
# because checkout never requires an account.
#
# Get the client id and secret from console.cloud.google.com → APIs & Services
# → Credentials → OAuth client ID (type: Web application).
# Authorised redirect URI must be exactly:
#   https://www.mawrestlingbelts.com/api/auth/callback/google
#
# AUTH_SECRET signs the session cookie. MINIMUM 32 CHARACTERS — a shorter one
# is treated as unset, because a guessable signing key means anyone can forge a
# session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# This file is COMMITTED. Never put a real value in it — real values belong in
# .env.local (git-ignored) and in the Vercel dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# PayPal. Card checkout stays hidden until BOTH of these exist, so the site
# never shows a pay button that cannot take money.
#
# IMPORTANT: PayPal does not onboard businesses registered in Pakistan. These
# must come from a PayPal Business account in a supported country — in practice
# that means a US or UK company. Get them from developer.paypal.com → Apps.
#
# Leave PAYPAL_ENV unset (or "sandbox") while testing. Only "live" takes real
# money, so a test key can never accidentally charge a customer.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Sign-in for /admin. Username defaults to "admin" if left blank.
#
# MINIMUM 12 CHARACTERS on the password — anything shorter is treated as unset
# and the panel stays closed. Leave the password blank to disable admin
# entirely. This one secret protects the whole shop: prices, orders, customer
# emails. Use a long passphrase you do not use anywhere else.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The original name for the same secret. Still honoured so existing deployments
# keep working; ADMIN_PASSWORD wins when both are set.
ADMIN_TOKEN=
